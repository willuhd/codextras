#!/bin/sh
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PID_FILE="$DIR/state/codextras.pid"
LOG_FILE="$DIR/logs/codextras.log"

case "$1" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "codextras already running (pid $(cat "$PID_FILE"))"
      exit 0
    fi
    mkdir -p "$DIR/state" "$DIR/logs"
    nohup bun run "$DIR/src/server.mjs" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "codextras started (pid $(cat "$PID_FILE")); log: $LOG_FILE"
    ;;
  stop)
    if [ ! -f "$PID_FILE" ]; then
      echo "codextras not running"
      exit 0
    fi
    PID=$(cat "$PID_FILE")
    kill "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "codextras stopped"
    ;;
  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "running (pid $(cat "$PID_FILE"))"
    else
      echo "not running"
      exit 1
    fi
    ;;
  catalog)
    bun -e 'import { loadConfig } from "./src/config.mjs"; import { catalogFor } from "./src/server.mjs"; console.log(JSON.stringify(catalogFor(loadConfig()), null, 2));'
    ;;
  catalog-merged)
    bun run "$DIR/src/catalog-cli.mjs"
    ;;
  dry-run)
    bun -e 'import { loadConfig, loadSecret } from "./src/config.mjs"; import { dryRunConfig } from "./src/codex-config.mjs"; const c = loadConfig(); const s = loadSecret(); const alias = process.argv[2] || (c.models[0] && c.models[0].alias); process.stdout.write(dryRunConfig(c, s, alias));'
    ;;
  apply)
    bun run "$DIR/src/apply.mjs" "$2"
    ;;
  restore)
    bun -e 'import { restoreConfig } from "./src/codex-config.mjs"; console.log("restored from", restoreConfig());'
    ;;
  *)
    echo "usage: codextras start|stop|status|catalog"
    exit 2
    ;;
esac
